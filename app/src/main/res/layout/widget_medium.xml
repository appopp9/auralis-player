<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/widget_artwork"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/widget_artwork_background"
        android:contentDescription="@string/cd_artwork"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_widget_note" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/nothing_playing"
            android:textColor="@color/widget_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text_secondary"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/widget_prev"
                android:layout_width="40dp"
                android:layout_height="36dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/cd_previous"
                android:src="@drawable/ic_widget_prev" />

            <ImageButton
                android:id="@+id/widget_play_pause"
                android:layout_width="40dp"
                android:layout_height="36dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/cd_play_pause"
                android:src="@drawable/ic_widget_play" />

            <ImageButton
                android:id="@+id/widget_next"
                android:layout_width="40dp"
                android:layout_height="36dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/cd_next"
                android:src="@drawable/ic_widget_next" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
